# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Sanidha source concerts (export to public/assets/raga-guess/)
/data/sanidha/Concert*/
/data/sanidha/var/
/public/assets/raga-guess/*.wav

# Legacy Saraga assets (removed from app — safe to delete locally)
/data/saraga-repo/
/data/saraga-mirdata/
/data/saraga1.5_carnatic.zip
/public/assets/saraga-guess/

# KritiSamhita source (export to public/assets/kriti-guess/)
/data/kriti-samhita/
/public/assets/kriti-guess/clips/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python (local ML services — not needed for Vercel)
.venv/
**/.venv/
__pycache__/
*.py[cod]

# Vendored clone (nested git repo — not used by the Next.js app)
/vendor/microtonal-carnatic/
